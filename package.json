{
  "name": "lank-hub",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "setup": "prisma generate && prisma db push && tsx prisma/seed.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:migrate": "prisma db push && prisma generate && tsx prisma/verify-existing.ts",
    "db:backfill-collections": "tsx prisma/backfill-collections.ts",
    "db:cleanup-awards": "tsx prisma/cleanup-awards.ts",
    "db:normalize-usernames": "tsx prisma/normalize-usernames.ts",
    "db:check-limits": "tsx prisma/check-limits.ts",
    "db:bind-music": "tsx prisma/bind-music.ts",
    "db:verify-existing": "tsx prisma/verify-existing.ts",
    "db:cleanup-unverified": "tsx prisma/cleanup-unverified.ts",
    "db:cleanup-codes": "tsx prisma/cleanup-codes.ts",
    "reset-password": "tsx prisma/reset-password.ts",
    "update": "bash scripts/backup.sh && git checkout -- package-lock.json && git pull && export better_sqlite3_binary_host=https://npmmirror.com/mirrors/better-sqlite3 && export NODEJS_ORG_MIRROR=https://npmmirror.com/mirrors/node && export PRISMA_ENGINES_MIRROR=https://npmmirror.com/mirrors/prisma && npm ci --prefer-offline --ignore-scripts && npm rebuild better-sqlite3 --build-from-source && npm run db:migrate && npm run build && pm2 restart next-app --update-env",
    "backup": "bash scripts/backup.sh",
    "restore": "bash scripts/restore.sh",
    "maintenance:build": "node maintenance/build.mjs",
    "maintenance:on": "bash scripts/maintenance/enable.sh",
    "maintenance:off": "bash scripts/maintenance/disable.sh",
    "maintenance:status": "bash scripts/maintenance/status.sh",
    "https:on": "bash scripts/https/enable.sh",
    "https:redirect": "bash scripts/https/enable-redirect.sh",
    "https:off": "bash scripts/https/disable.sh",
    "email:test": "tsx scripts/email-test.mts",
    "email:check": "tsx scripts/email-check.mts",
    "email:code-test": "tsx scripts/verify-code-test.mts",
    "auth:session-test": "tsx scripts/session-invalidation-test.mts",
    "music:order-test": "tsx scripts/play-order-test.mts",
    "music:error-code-test": "tsx scripts/music-error-code-test.mts",
    "music:ui-check": "tsx scripts/music-ui-check.mts",
    "security:xff-test": "tsx scripts/xff-ip-test.mts",
    "music:shuffle-test": "tsx scripts/shuffle-start-test.mts",
    "music:upstream-test": "tsx scripts/upstream-shape-test.mts",
    "ui:check": "node scripts/ui-check.mjs",
    "ui:settings": "tsx scripts/settings-ui-check.mts",
    "ui:measure-code": "tsx scripts/measure-code-row.mts",
    "db:state": "tsx scripts/db-state.mts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tiptap/extension-code-block-lowlight": "^3.27.1",
    "@tiptap/extension-image": "^3.27.1",
    "@tiptap/extension-link": "^3.27.1",
    "@tiptap/extension-placeholder": "^3.27.1",
    "@tiptap/pm": "^3.27.1",
    "@tiptap/react": "^3.27.1",
    "@tiptap/starter-kit": "^3.27.1",
    "bcryptjs": "^3.0.3",
    "dayjs": "^1.11.21",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.21.0",
    "next": "^16.3.0",
    "next-auth": "^5.0.0-beta.32",
    "prisma": "^7.8.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "slugify": "^1.6.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.0",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5"
  }
}
