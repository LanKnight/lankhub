generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id          Int       @id @default(autoincrement())
  email       String    @unique
  password    String
  // 昵称唯一：否则无法区分同名用户，也挡不住「注册成站长」这类冒充。
  // 上线前必须先跑 npm run db:normalize-usernames 清理存量重名，否则 db push 会失败。
  name        String    @unique
  role        String    @default("READER")
  avatar      String?
  bio         String?
  permissions String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  articles    Article[]
  comments    Comment[]
  photos      Photo[]
  poems       Poem[]
  songs       Song[]
  sessions    Session[]
  accounts    Account[]
}

model Session {
  id           Int      @id @default(autoincrement())
  sessionToken String   @unique
  userId       Int
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime
}

model Account {
  id                Int      @id @default(autoincrement())
  userId            Int
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  @@unique([provider, providerAccountId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Collection {
  id          Int       @id @default(autoincrement())
  name        String
  slug        String    @unique
  description String?
  coverImage  String?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  articles    Article[]

  @@index([sortOrder])
}

model Article {
  id           Int         @id @default(autoincrement())
  title        String
  slug         String      @unique
  summary      String?
  content      String
  coverImage   String?
  published    Boolean     @default(false)
  pinned       Boolean     @default(false)
  viewCount    Int         @default(0)
  authorId     Int
  author       User        @relation(fields: [authorId], references: [id])
  collectionId Int?
  collection   Collection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  comments     Comment[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([published, createdAt])
  @@index([pinned, createdAt])
  @@index([collectionId])
}

model Comment {
  id        Int       @id @default(autoincrement())
  content   String
  articleId Int
  article   Article   @relation(fields: [articleId], references: [id], onDelete: Cascade)
  authorId  Int?
  author    User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)
  parentId  Int?
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies   Comment[] @relation("CommentReplies")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([articleId, createdAt])
}

model ResumeProfile {
  id             Int               @id @default(autoincrement())
  name           String            @default("")
  title          String            @default("")
  email          String            @default("")
  phone          String            @default("")
  location       String            @default("")
  avatar         String?
  birthDate      String            @default("")
  birthplace     String            @default("")
  degree         String            @default("")
  political      String            @default("")
  selfEvaluation String            @default("")
  jobTarget      String            @default("")
  jobSummary     String            @default("")
  hobbies        String            @default("")
  resumePdf      String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  skills         ResumeSkill[]
  experiences    ResumeExperience[]
}

model ResumeSkill {
  id        Int           @id @default(autoincrement())
  name      String
  level     Int           @default(0)
  sortOrder Int           @default(0)
  profileId Int
  profile   ResumeProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model ResumeExperience {
  id          Int           @id @default(autoincrement())
  type        String
  title       String
  subtitle    String?
  startDate   String?
  endDate     String?
  description String?
  techStack   String?
  sortOrder   Int           @default(0)
  profileId   Int
  profile     ResumeProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, type])
}

model Photo {
  id          Int      @id @default(autoincrement())
  filename    String   @unique
  url         String
  category    String
  title       String?
  description String?
  width       Int?
  height      Int?
  sortOrder   Int      @default(0)
  authorId    Int?
  author      User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category, sortOrder])
  @@index([category, createdAt])
}

model Poem {
  id        Int      @id @default(autoincrement())
  content   String
  author    String?
  source    String?
  sortOrder Int      @default(0)
  authorId  Int?
  user      User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

/// 歌单：我喜欢的歌。前台按歌手分组展示，所以 artist 是必填。
model Song {
  id        Int      @id @default(autoincrement())
  title     String
  artist    String
  /// 外链（QQ音乐 / 网易云 / YouTube 等），可选
  link      String?
  /// 特别推荐：在所属歌手分组里置顶并加标记
  favorite  Boolean  @default(false)
  sortOrder Int      @default(0)
  authorId  Int?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// 前台按歌手分组取数，所以索引带上 artist
  @@index([artist, sortOrder])
  @@index([sortOrder, createdAt])
}
