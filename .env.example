# ============================================
# lankHub 环境变量配置
# 使用方法：复制此文件为 .env 并修改对应值
#   cp .env.example .env
#
# Next.js 会**原生加载** .env / .env.local 到 process.env，不需要 dotenv。
# 依据：node_modules/next/dist/docs/01-app/02-guides/environment-variables.md
# 注意它**不覆盖**已存在的 shell 环境变量（便于临时覆盖测试）。
# ============================================

# 数据库路径（SQLite）
# 本地开发用相对路径，服务器建议用绝对路径
DATABASE_URL="file:./dev.db"

# Auth.js 密钥 — 用于加密 JWT session
# 生成方式：openssl rand -base64 32
AUTH_SECRET="请替换为随机生成的密钥"

# Auth.js 回调 URL（生产环境改为实际域名，如 https://lankhub.xyz）
NEXTAUTH_URL="http://localhost:3000"

# 公开访问的网站 URL（用于 sitemap、robots.txt）
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ============================================
# 邮件（Resend）—— 用于注册验证、验证码登录、忘记密码
# 完整方案见 docs/emailAuthDevDoc.md
# ============================================

# 邮件功能总开关。
# 出问题时可设为 false 并 pm2 restart next-app：所有发码接口会明确返回
# 「邮件功能暂时关闭」，而**密码登录不受影响**（这是保留密码登录的价值）。
EMAIL_ENABLED=true

# Resend API Key，形如 re_xxxxxxxx
#
# ⚠️ 三条红线：
#   1. **绝不提交到仓库**。只有 .env.example 入库，且它的值是空的
#   2. **不要**写进 /etc/profile.d/*.sh —— 那种方式下 PM2 进程很可能读不到
#      （/etc/profile.d 只在登录 shell 生效，而 PM2 由 systemd/非登录 shell 启动，
#       环境在启动那一刻就被冻结）
#   3. 改完这个值后需要 `pm2 restart next-app --update-env` 才会生效
#
# 验证是否真的被进程读到（比 echo $VAR 有意义）：
#   curl -s http://127.0.0.1:3000/api/auth/email-health
# 期望 keyLoaded 为 true。该接口只回长度，**不回 Key 的任何字符**。
RESEND_API_KEY=""

# 发件地址。域名必须已在 Resend 完成 DKIM/SPF/DMARC 验证，
# 否则 Resend 会返回 403（"You can only send testing emails..."）。
EMAIL_FROM="noreply@lankhub.xyz"

# 站点名，用在邮件主题与正文里
EMAIL_SITE_NAME="lankHub"
