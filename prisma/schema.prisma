generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id          Int       @id @default(autoincrement())
  email       String    @unique
  password    String
  // 昵称唯一：否则无法区分同名用户，也挡不住「注册成站长」这类冒充。
  // 上线前必须先跑 npm run db:normalize-usernames 清理存量重名，否则 db push 会失败。
  name        String    @unique
  role        String    @default("READER")
  avatar      String?
  bio         String?
  permissions String?
  /// 邮箱验证时间。null = 未验证（注册后还没输验证码）。
  ///
  /// 为什么用 DateTime 而不是 Boolean：顺带留下「何时验证的」审计信息，
  /// 而且与 Auth.js 的 emailVerified 语义相容，将来换 adapter 不用改字段含义。
  ///
  /// 加这个字段之后，**存量账号必须先跑 npm run db:verify-existing 标记为已验证**，
  /// 否则他们会被「请先完成邮箱验证」挡在门外。
  emailVerifiedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  articles    Article[]
  comments    Comment[]
  photos      Photo[]
  poems       Poem[]
  songs       Song[]
  sessions    Session[]
  accounts    Account[]

  /// 清理「未验证账号」的任务要按这个字段筛
  @@index([emailVerifiedAt])
}

/// 邮箱验证码。四个场景（注册 / 验证码登录 / 重置密码 / 改密码）**共用一张表**，
/// 用 scene 区分 —— 字段完全一致，只用途不同；统一表能让限流与配额统计只用一套查询。
///
/// ⚠️ 这里存的是 **HMAC 哈希，不是明文**：
///   hash = HMAC-SHA256(AUTH_SECRET, `${email}:${scene}:${code}`)
/// 用 HMAC 而不是 bcrypt 的理由：验证码只有 6 位（100 万种），真正的防线是
/// 「错误次数上限」而不是哈希强度；HMAC 让「6 位码 → 库里的值」不可逆就足够了，
/// 且不必为每次比对付 bcrypt 约 100ms 的开销。
/// 代价是库里看不到明文，排查问题不能直接读库（开发环境另允许打日志）。
///
/// 注意这里**不建到 User 的外键**：注册场景要能为「还没有账号的邮箱」存码，
/// 登录/改密码场景也只需要按 email 查。用 email 关联更简单也更通用。
model EmailCode {
  id        Int       @id @default(autoincrement())
  email     String
  /// register | login | reset | change
  /// 用字符串而不是 enum：SQLite 下 Prisma enum 支持有限，且加场景时不必改表
  scene     String
  codeHash  String
  expiresAt DateTime
  /// 已尝试比对次数。达到上限后该记录**直接作废**（不再看是否还在有效期内）
  attempts  Int       @default(0)
  /// 请求发码的客户端 IP。用于「单 IP 日限」配额，也便于排查异常刷量
  ip        String?
  /// 用后即焚：消费后写入时间戳，同一码不可二次使用
  consumedAt DateTime?
  createdAt DateTime  @default(now())

  /// 最高频查询是「取该邮箱该场景最新的有效码」
  @@index([email, scene, createdAt])
  /// 全站配额统计与清理任务按时间扫
  @@index([createdAt])
  /// 单 IP 日限要按 ip + 时间筛
  @@index([ip, createdAt])
}

model Session {
  id           Int      @id @default(autoincrement())
  sessionToken String   @unique
  userId       Int
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime
}

model Account {
  id                Int      @id @default(autoincrement())
  userId            Int
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  @@unique([provider, providerAccountId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Collection {
  id          Int       @id @default(autoincrement())
  name        String
  slug        String    @unique
  description String?
  coverImage  String?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  articles    Article[]

  @@index([sortOrder])
}

model Article {
  id           Int         @id @default(autoincrement())
  title        String
  slug         String      @unique
  summary      String?
  content      String
  coverImage   String?
  published    Boolean     @default(false)
  pinned       Boolean     @default(false)
  viewCount    Int         @default(0)
  authorId     Int
  author       User        @relation(fields: [authorId], references: [id])
  collectionId Int?
  collection   Collection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  comments     Comment[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([published, createdAt])
  @@index([pinned, createdAt])
  @@index([collectionId])
}

model Comment {
  id        Int       @id @default(autoincrement())
  content   String
  articleId Int
  article   Article   @relation(fields: [articleId], references: [id], onDelete: Cascade)
  authorId  Int?
  author    User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)
  parentId  Int?
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies   Comment[] @relation("CommentReplies")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([articleId, createdAt])
}

model ResumeProfile {
  id             Int               @id @default(autoincrement())
  name           String            @default("")
  title          String            @default("")
  email          String            @default("")
  phone          String            @default("")
  location       String            @default("")
  avatar         String?
  birthDate      String            @default("")
  birthplace     String            @default("")
  degree         String            @default("")
  political      String            @default("")
  selfEvaluation String            @default("")
  jobTarget      String            @default("")
  jobSummary     String            @default("")
  hobbies        String            @default("")
  resumePdf      String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  skills         ResumeSkill[]
  experiences    ResumeExperience[]
}

model ResumeSkill {
  id        Int           @id @default(autoincrement())
  name      String
  level     Int           @default(0)
  sortOrder Int           @default(0)
  profileId Int
  profile   ResumeProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model ResumeExperience {
  id          Int           @id @default(autoincrement())
  type        String
  title       String
  subtitle    String?
  startDate   String?
  endDate     String?
  description String?
  techStack   String?
  sortOrder   Int           @default(0)
  profileId   Int
  profile     ResumeProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, type])
}

model Photo {
  id          Int      @id @default(autoincrement())
  filename    String   @unique
  url         String
  category    String
  title       String?
  description String?
  width       Int?
  height      Int?
  sortOrder   Int      @default(0)
  authorId    Int?
  author      User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category, sortOrder])
  @@index([category, createdAt])
}

model Poem {
  id        Int      @id @default(autoincrement())
  content   String
  author    String?
  source    String?
  sortOrder Int      @default(0)
  authorId  Int?
  user      User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

/// 歌单：我喜欢的歌。前台按歌手分组展示，所以 artist 是必填。
model Song {
  id        Int      @id @default(autoincrement())
  title     String
  artist    String
  /// 特别推荐：在所属歌手分组里置顶并加标记
  favorite  Boolean  @default(false)
  sortOrder Int      @default(0)
  authorId  Int?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ---- 在线播放（GD音乐台 API）。实测结论见 docs/music-plan.md ----
  // 只有 netease 是真正能播的音源：kuwo 被服务端直接拒绝，
  // joox 能搜到但取不到播放链接，其余音源全部 400。
  /// 音源，目前固定为 netease
  source    String   @default("netease")
  /// 播放用的 url_id；为空表示这首歌还没绑定到 API
  apiId     String?
  /// 取封面与歌词用的 ID
  picId     String?
  lyricId   String?
  /// 封面地址与歌词在「绑定」那一刻就抓取入库，
  /// 这样前台渲染卡片墙与歌词是零 API 调用（官方限流 60 次/5 分钟）
  coverUrl  String?
  lyric     String?
  album     String?
  /// 自动匹配的结论：为空=没试过；"nomatch"=试过但没有原版（如网易云无周杰伦版权）。
  /// 记下来是为了不反复搜索这些歌、白耗第三方配额
  matchStatus String?

  /// 前台按歌手分组取数，所以索引带上 artist
  @@index([artist, sortOrder])
  @@index([sortOrder, createdAt])
}
